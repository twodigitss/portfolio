---
import BaseLayout from "../layout/base.astro";
import PosterCard from "../components/PosterCard.astro";
import Projects from "./projects.astro";
import Nav from "../components/Nav.astro";
import Exp from "./exp.astro"
---
<BaseLayout>

  <section class="flex gap-8">

    <header class="flex flex-col bg-white justify-between h-screen border-b">
      <span>
        <p class="font-title text-[15rem] m-0 leading-none font-bold ">Developer</p>
        <p class="font-title text-[5rem] m-0 leading-none font-light ">Enrique Torres</p>
      </span>

      <Exp/>
    </header>

    <!-- bg-gradient-to-b from-gray-950 to-transparent -->
    <aside class="flex font-title pb-12 bg-[#171717] w-full items-end justify-center"> 
      <Nav/>
    </aside>
  </section>

  <div class="mt-8 border-b"></div>
  <!-- <div class="my-0 ml-16 border-l absolute h-screen"></div> -->

  <p class="font-title text-right text-[15rem] m-0 pr-8 mt-15 leading-none font-bold ">Projects</p>
  <div class="flex items-center justify-center px-[20rem] pt-20">
    <Projects/>
  </div>

  <div class="mb-44"></div>

</BaseLayout>
