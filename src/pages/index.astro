---
import BaseLayout from "../layout/base.astro";
import Projects from "../layout/components/projects.astro";
import Socials from "../layout/components/socials.astro";
import Exp from "../layout/components/experience.astro";

import { CV } from "../data.ts";
const cv = await CV();
---

<BaseLayout>
    <!-- ─── ME SECTION ─────────────────────────────────────────── -->
    <section class="flex flex-col lg:flex-row w-full h-full">

        <!-- Avatar + socials sidebar -->
        <aside class="flex flex-col font-title p-2 bg-[#1B1B1B] w-full lg:max-w-100 justify-start">
            <span class="block w-full">
                <img
                class="w-full object-cover object-top max-h-[60vw] lg:max-h-none aspect-square"
                src="https://avatars.githubusercontent.com/u/100657622?v=4"
                />
            </span>

            <div class="flex flex-col py-4">
                <Socials />
            </div>
        </aside>

        <!-- Main text + experience -->
        <header class="flex flex-col justify-between border-b w-full md:gap-8 sm:gap-8 ">
            <span class="grid pl-4 gap-5 lg:pl-8">
                <p class="font-switzer text-[clamp(2.5rem,8vw,10rem)] m-0 p-0 pt-4 tracking-tight leading-none font-bold">
                    Enrique Torres
                </p>
                <p class="font-sans-flex text-[clamp(1.5rem,4vw,4.5rem)] text-[#2e2e2e] m-0 leading-none font-light text-cursor">
                    Software Engineer
                </p>
            </span>
            <div class="px-4 lg:px-8">
                { cv.professional_summary && (
                  <div class="grid mb-2 gap-1 pb-6 font-sans-flex"> 
                      <h1 class="font-normal text-[clamp(1.2rem,4vw,2.25rem)]">About Me :</h1>
                      {cv.professional_summary.map((p: string) => (
                      <p class="w-full max-w-[70ch] font-normal text-[clamp(0.75rem,2vw,1.2rem)]">{p}</p>
                      ))}
                  </div>
                  )
                }
            </div>
        </header>

    </section>

    <!-- ───  EXPERIENCE ────────────────────────────────────── -->

    <!-- <div class="mt-16 w-full border-b"></div> -->
    <div class="my-12 w-full border-b-[0.1rem]"></div>

    <Exp />

    <div class="my-12 w-full border-b-[0.1rem]"></div>

    <!-- ─── FEATURED PROJECTS ────────────────────────────────────── -->

    <Projects />

    <div class="mb-22"></div>
</BaseLayout>
