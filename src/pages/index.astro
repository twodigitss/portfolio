---
import BaseLayout from "../layout/base.astro";
import PosterCard from "../components/PosterCard.astro";
import Projects from "./projects.astro";
import Nav from "../components/Nav.astro";
import Exp from "./exp.astro"

---
<BaseLayout>

  <section class="flex w-full h-full gap-8">

    <header class="flex flex-col bg-white justify-between h-screen border-b">
      <span>
        <p class="font-title text-[9rem] m-0 p-0 pt-4 self-center-safe leading-none font-bold ">Enrique Torres</p>
        <p class="font-title text-[5rem] m-0 leading-none font-light ">Software Engineer</p>
      </span>
      <Exp/>
    </header>
    <!-- <div class="absolute top-110 left-250 w-75 h-20 bg-red-100 "></div> -->
    <!-- <div class="absolute top-110 left-259 w-75 h-20 bg-[linear-gradient(to_right,#000_60%,#fff_60%)]"></div> -->

    <!-- bg-gradient-to-b from-gray-950 to-transparent -->
    <aside class="flex flex-col font-title pb-12 bg-[#171717] w-full max-w-100 justify-between ml-auto sticky top-0 h-screen"> 

        <span class="TOP grid gap-4  block w-full">
          <img class="aspect-square w-full object-cover" src="https://avatars.githubusercontent.com/u/100657622?s=400&u=9249e7e45078d44984c9314ff1a673ada9f76cbd&v=4"/>
        </span>

      <div class="flex flex-col items-center">
        <Nav/>
      </div>

    </aside>
  </section>

  <div class="mt-16 w-full border-b"></div>
  <!-- <div class="my-0 ml-16 border-l absolute h-fit h-screen"></div> -->

  <p class="font-title text-right text-[5rem] m-0 pr-16 mt-15 text-center leading-none font-bold ">Featured</p>
  <p class="font-title text-[3rem] m-0 leading-none pr-16 font-light text-right ">Projects</p>
  <div class="flex  justify-center px-[5rem] pt-40">
    <Projects/>
  </div>

  <div class="mb-44"></div>

</BaseLayout>
