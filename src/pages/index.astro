---
import BaseLayout from "../layout/base.astro";
import Projects from "../layout/components/projects.astro";
import Nav from "../layout/components/nav.astro";
import Exp from "../layout/components/experience.astro";

import { CV } from "../data.ts";
const cv = await CV();
---

<BaseLayout>
    <!-- ─── ME SECTION ─────────────────────────────────────────── -->
    <section class="flex w-full h-full ">

        <!-- Desktop sidebar: avatar + nav vertical -->
        <aside class="flex flex-col gap-30 font-title p-2  bg-[#1B1B1B] w-full max-w-100 justify-between  " >
            <span class="TOP gap-4 block w-full ">
                <img
                class="aspect-square w-full object-cover "
                src="https://avatars.githubusercontent.com/u/100657622?v=4"
                />
            </span>

            <div class="flex flex-col items-center pb-4">
                <Nav />
            </div>
        </aside>


        <!-- Main text + experience -->
        <header class="flex flex-col justify-between border-b w-full" >
            <span class="pl-8">
                <p class="font-switzer text-[10rem] m-0 p-0 pt-4 tracking-tight leading-none font-bold" >
                    Enrique Torres
                </p>
                <p class="font-sans-flex text-7xl text-[#2e2e2e] m-0 leading-none font-light text-cursor" >
                    Software Engineer
                </p>
            </span>
            <div class="px-8">
                { cv.professional_summary && (
                  <div class="grid mb-2 gap-4 pb-6 px-4 lg:px-0 font-sans-flex">
                      <h1 class="font-normal text-3xl lg:text-4xl">About Me :</h1>
                      {cv.professional_summary.map((p: string) => (
                      <p class=" w-[70ch]  text-sm lg:text-xl">{p}</p>
                      ))}
                  </div>
                  )
                }
            </div>
        </header>

    </section>

    <!-- ───  EXPERIENCE ────────────────────────────────────── -->

    <!-- <div class="mt-16 w-full border-b"></div> -->

    <!-- <Exp /> -->

    <div class="mt-12 w-full border-b-[0.1rem]"></div>
    <div class="mt-16 w-full"></div>

    <!-- ─── FEATURED PROJECTS ────────────────────────────────────── -->

    <Projects />

    <!-- <div class="mb-44"></div> -->
</BaseLayout>
