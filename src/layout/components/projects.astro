---
import Block from "./card.astro";
import apioImg from "../../assets/apio_demo.png";
import pperImg from "../../assets/pageper_demo.png";
---

<div class="flex flex-col w-full ml-6 ">
    <section class="flex w-full px-16 items-center">
        <span class="grid justify-between w-full">
            <p class=" text-[6rem] m-0 p-0 text-left leading-none font-bold" >
                Featured
            </p>
            <p class=" text-[5rem] m-0 p-0 leading-none font-light text-left" >
                Projects
            </p>
        </span>
        <span class="font-sans-flex font-bold text-[9rem] m-0 p-0 text-left leading-none border-l-[0.1rem] pl-12"> 02 </span>
    </section>

    <span class="grid px-20 pt-30">
        <Block
        title="Apio"
        image={apioImg.src}
        consecutive="01"
        url="https://github.com/twodigitss/apio"
        description="Apio is a Terminal UI tool that runs requests from your local HTTP / REST files."
        technologies={`Go, Bubbletea, Lipgloss`}
        />

        <Block
        title="Pageper"
        image={pperImg.src}
        consecutive="02"
        url="https://github.com/twodigitss/Pageper"
        description="Keyboard centered, minimalist and distraction free bookmark startup page for browsers."
        technologies={`React.js, Typescript, TailwindCSS, HTML`}
        reversed
        />
    </span>
</div>
