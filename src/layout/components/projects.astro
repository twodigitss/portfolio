---
import Block from "./card.astro";
import apioImg from "../../assets/apio_demo.png";
import pperImg from "../../assets/pageper_demo.png";

const projects = [
    {
        title: "Apio",
        image: apioImg.src,
        url: "https://github.com/twodigitss/apio",
        description: "Apio is a Terminal UI tool that runs requests from your local HTTP / REST files.",
        technologies: `Go, Bubbletea, Lipgloss`,
        reversed: false,
    },
    {
        title: "Pageper",
        image: pperImg.src,
        url: "https://github.com/twodigitss/Pageper",
        description: "Keyboard centered, minimalist and distraction free bookmark startup page for browsers.",
        technologies: `React.js, Typescript, TailwindCSS, HTML`,
        reversed: true,
    },
];

---

<div class="flex flex-col w-full px-4 lg:px-16 overflow-hidden">
    <section class="flex flex-col lg:flex-row w-full items-start lg:items-center gap-2 lg:gap-0">

        <span class="grid items-center w-full lg:w-auto">
            <p class="font-sans-flex text-[clamp(3.5rem,8vw,6rem)] m-0 p-0 leading-none font-bold">
                Featured
            </p>
            <p class="font-switzer text-[clamp(2.5rem,6vw,4rem)] m-0 p-0 leading-none font-light">
                Projects
            </p>
        </span>

        <div class="w-full lg:flex-1 font-normal text-[clamp(1rem,2vw,1.3rem)] pb-1 font-sans-flex border-b-[0.1rem] lg:mx-4">
            Personal tools built outside of work
        </div>

        <span class="font-sans-flex font-bold text-[clamp(5rem,12vw,9rem)] m-0 p-0 text-left leading-none lg:border-l-[0.2rem] lg:pl-12 self-end lg:self-auto"> {String(projects.length).padStart(2, '0')} </span>
    </section>

    <span class="grid pt-20">

        {projects.map((project, i) => (
            <Block
                title={project.title}
                consecutive={String(i + 1).padStart(2, '0')}
                image={project.image}
                url={project.url}
                description={project.description}
                technologies={project.technologies}
                reversed={project.reversed}
            />
        ))}

    </span>
</div>
