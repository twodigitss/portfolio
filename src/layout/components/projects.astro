---
import Block from "./card.astro";
import apioImg from "../../assets/apio_demo.png";
import pperImg from "../../assets/pageper_demo.png";
---

<div class="flex flex-col w-full bg-white">
    <p
        class="font-title text-[clamp(3rem,5vw,6rem)] m-0 px-4 lg:pr-16 mt-8 lg:mt-15 text-left ml-12 leading-none font-bold reveal"
    >
        Featured
    </p>
    <p
        class="font-title text-[clamp(1.8rem,4vw,5rem)] m-0 leading-none px-4 lg:pr-16 font-light ml-12 text-left reveal delay-200"
    >
        Projects
    </p>

    <span class="grid px-4 sm:px-8 lg:px-20 pt-16 lg:pt-30">
        <Block
            title="Apio"
            image={apioImg.src}
            consecutive="01"
            url="https://github.com/twodigitss/apio"
            description="Apio is a Terminal UI tool that runs requests from your local HTTP / REST files."
            technologies={`Go, Bubbletea, Lipgloss`}
        />

        <Block
            title="Pageper"
            image={pperImg.src}
            consecutive="02"
            url="https://github.com/twodigitss/Pageper"
            description="Keyboard centered, minimalist and distraction free bookmark startup page for browsers."
            technologies={`React.js, Typescript, TailwindCSS, HTML`}
            reversed
        />
    </span>
</div>
