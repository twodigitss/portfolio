---
import { CV } from "../../data.ts";
const cv = await CV();
---

{
    cv.professional_summary && (
        <div class="grid mb-8 pb-6 px-4 lg:px-0">
            <h1 class="font-normal text-2xl lg:text-4xl">About Me</h1>
            {cv.professional_summary.map((p: string) => (
                <p class="mt-4 lg:w-[60ch] text-sm lg:text-lg">{p}</p>
            ))}
        </div>
    )
}
