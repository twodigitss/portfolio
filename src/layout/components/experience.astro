---
// Tailwind needs literal class names at build time — can't interpolate
// "grid-cols-" + n, so we map count -> class explicitly.
const colsByCount: Record<number, string> = {
    1: "md:grid-cols-1",
    2: "md:grid-cols-2",
    3: "md:grid-cols-3",
    4: "md:grid-cols-4",
    5: "md:grid-cols-5",
    6: "md:grid-cols-6",
};

// Hardcoded data — swap for real content later
const experience = {
    company: "Empresa Confidencial",
    role: "Software Engineer",
    period: "2025 — Present",
};

const projects = [
    {
        number: "",
        name: "",
        description: "",
        stack: "",
    },
    {
        number: "",
        name: "",
        description: "",
        stack: "",
    },
    {
        number: "",
        name: "",
        description: "",
        stack: "",
    },
];

// Falls back to a sane grid if someone adds more than 6 (2 cols on mobile, 3 on desktop)
const gridColsClass = colsByCount[projects.length] ?? "md:grid-cols-3";
---

<!-- Section header — EXPERIENCE compact, subordinate to nothing below it -->
<section
    class="bg-black text-white px-6 md:px-16 pt-16 md:pt-20 pb-10 md:pb-12 border-b border-neutral-800"
>
    <div
        class="grid grid-cols-1 md:grid-cols-[1fr_1fr] gap-6 md:gap-16 items-start"
    >
        <p
            class="text-sm md:text-base text-neutral-400 leading-relaxed border-t border-neutral-800 pt-4 md:pt-0 md:border-t-0 md:border-r md:border-neutral-800 md:pr-8"
        >
            {experience.company} — {experience.role}, {experience.period}.
            Cuatro proyectos desarrollados dentro del mismo equipo, cubriendo
            formularios transaccionales, visualización 3D, dashboards de
            seguimiento y digitalización de procesos internos.
        </p>
        <h1
            class="text-5xl text-right md:text-7xl font-bold leading-none tracking-tight"
        >
            Experience
        </h1>
    </div>
</section>

<!-- Body: placeholder panel (left) + 4 numbered columns (right) -->
<section class="bg-black text-white px-6 md:px-16 py-10 md:py-14">
    <div class="grid grid-cols-1 md:grid-cols-[280px_1fr] gap-8 md:gap-10">
        <!-- Plain blank rectangle standing in for imagery -->
        <div
            class="w-full h-64 md:h-full min-h-80 bg-white border border-white"
        >
        </div>

        <!-- 4 equal-weight columns, no single project dominates -->
        <div class={`grid grid-cols-2 ${gridColsClass} gap-6 md:gap-8`}>
            {
                projects.map((project) => (
                    <div class="border-t border-white pt-4">
                        <div class="flex items-center justify-between mb-4">
                            <span class="text-[10px] tracking-widest text-neutral-500 uppercase">
                                {project.stack.split(",")[0]}
                            </span>
                            <span class="w-7 h-7 rounded-full border border-white flex items-center justify-center text-xs font-medium shrink-0">
                                {project.number.replace("0", "")}
                            </span>
                        </div>
                        <h3 class="text-sm font-bold leading-tight mb-3">
                            {project.name}
                        </h3>
                        <p class="text-xs text-neutral-400 leading-relaxed">
                            {project.description}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
