---
interface Props {
    title?: string;
    image: string;
    consecutive: string;
    url: string;
    description?: string;
    technologies?: string;
    reversed?: boolean;
}

const {
    title = "",
    image,
    consecutive,
    url,
    description = "",
    technologies = "",
    reversed = false,
} = Astro.props;
---

<article
    class={`group flex flex-col w-full min-h-90 border border-black overflow-hidden transition-colors duration-300 ${reversed ? "lg:flex-row-reverse" : "lg:flex-row"}`}
>
    <!-- image — square on side -->
    <div class="flex-none lg:aspect-square overflow-hidden" >
        <img
            src={image}
            class="w-full lg:w-100 h-64 lg:h-full object-cover object-center"
        />
    </div>

    <!-- text half -->
    <div class="flex-1 flex flex-col p-6 lg:p-10 border-neutral-200 group-hover:border-neutral-800" >
        <div class="flex justify-between mb-auto">
            <span class="text-base tracking-widest uppercase opacity-35" >{consecutive}</span >
            <a
                href={url}
                target="blank"
                class="text-sm tracking-widest uppercase opacity-35 transition-opacity duration-200 hover:opacity-80"
                >[ source code ]</a
            >
        </div>

        <h2 class="font-title text-[4rem] font-normal leading-[0.9] uppercase tracking-tight my-4 transition-transform duration-500 group-hover:translate-x-1" >
            <p class="font-light">{title}</p>
        </h2>

        {
            description && (
                <p class="text-lg leading-relaxed opacity-55 mb-2 max-w-[36ch] transition-opacity duration-300 group-hover:opacity-80">
                    {description}
                </p>
            )
        }
        {
            technologies && (
                <p class="text-md tracking-wider uppercase opacity-30">
                    {technologies}
                </p>
            )
        }

        <div class="mt-auto pt-8">
            <span
                class="text-xl opacity-35 inline-block transition-transform duration-400 group-hover:translate-y-1 group-hover:opacity-70"
                >↓</span
            >
        </div>
    </div>
</article>
