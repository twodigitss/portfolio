---
interface Props {
  titleTop?: string;
  titleBottom?: string;
  image: string;
  imageAlt?: string;
  day: string;
  month: string;
  firstName: string;
  lastName: string;
  description?: string;
  venue?: string;
  reversed?: boolean;
}

const {
  titleTop = "", titleBottom = "",
  image, imageAlt = "",
  day, month,
  firstName, lastName,
  description = "", venue = "",
  reversed = false,
} = Astro.props;
---

<article class={`group flex w-full min-h-[360px] border border-neutral-200 bg-white overflow-hidden transition-colors duration-300 hover:bg-neutral-950 hover:text-white ${reversed ? "flex-row-reverse" : ""}`}>

  <!-- text half -->
  <div class={`flex-1 flex flex-col p-10 ${reversed ? "border-l" : "border-r"} border-neutral-200 group-hover:border-neutral-800`}>
    <div class="flex justify-between mb-auto">
      <span class="text-[0.65rem] tracking-widest uppercase opacity-35">{day}</span>
      <span class="text-[0.65rem] tracking-widest uppercase opacity-35">{month}</span>
    </div>

    {titleTop && <p class="text-[0.65rem] tracking-wider uppercase opacity-40 mt-8 mb-1">{titleTop}</p>}

    <h2 class="font-title text-[clamp(3rem,6vw,5rem)] font-normal leading-[0.9] uppercase tracking-tight my-4">
      {firstName}<br /><strong class="font-black">{lastName || titleBottom}</strong>
    </h2>

    {description && <p class="text-[0.8rem] leading-relaxed opacity-55 mb-2 max-w-[36ch]">{description}</p>}
    {venue      && <p class="text-[0.65rem] tracking-wider uppercase opacity-30">{venue}</p>}

    <div class="mt-auto pt-8">
      <span class="text-xl opacity-35">↓</span>
    </div>
  </div>

  <!-- image half -->
  <div class="flex-none aspect-square overflow-hidden">
    <img
      src={image}
      alt={imageAlt}
      class="w-100 h-fit aspect-square object-cover object-center transition-transform duration-500 group-hover:scale-[1.04] group-hover:grayscale-[30%]"
    />
  </div>

</article>
