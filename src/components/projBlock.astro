---
interface Props {
  title?: string;
  image: string;
  consecutive: string;
  url: string;
  description?: string;
  technologies?: string;
  reversed?: boolean;
}

const {
  title = "", image,
  consecutive, url,
  description = "", technologies = "",
  reversed = false,
} = Astro.props;
---

<article class={`group flex w-full min-h-[360px] border border-neutral-200 bg-white overflow-hidden transition-colors duration-300 hover:bg-neutral-950 hover:text-white ${reversed ? "flex-row-reverse" : ""}`}>

  <!-- text half -->
  <div class={`flex-1 flex flex-col p-10 border-neutral-200 group-hover:border-neutral-800`}>
    <div class="flex justify-between mb-auto">
      <span class="text-base tracking-widest uppercase opacity-35">{consecutive}</span>
      <a href={url} target="blank" class="text-sm tracking-widest uppercase opacity-35">[ source code ]</a>
    </div>


    <h2 class="font-title text-[clamp(3rem,6vw,4rem)] font-normal leading-[0.9] uppercase tracking-tight my-4">
      <p class="font-light">{title}</p>
    </h2>

    {description && <p class="text-lg leading-relaxed opacity-55 mb-2 max-w-[36ch]">{description}</p>}
    {technologies      && <p class="text-md tracking-wider uppercase opacity-30">{technologies}</p>}

    <div class="mt-auto pt-8">
      <span class="text-xl opacity-35">↓</span>
    </div>
  </div>

  <!-- image half -->
  <div class="flex-none aspect-square overflow-hidden">
    <img
      src={image}
      class="w-100 h-fit aspect-square object-cover object-center transition-transform duration-500 group-hover:scale-[1.04] group-hover:grayscale-[30%]"
    />
  </div>

</article>
